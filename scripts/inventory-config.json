{
  "family": "SGI L1 and L2 system-controller firmware and its host tools",
  "siblings": {},
  "docs": {
    "prose": [
      "docs/*.md",
      "docs/*/*.md",
      "README.md"
    ],
    "headers": [
      "include/*.h",
      "*/include/*.h"
    ],
    "tables": [
      "docs/*/*.tsv",
      "*/*.tsv",
      "*/*/*.tsv",
      "*/*/*/*.tsv"
    ],
    "index": [
      "AGENTS.md",
      "README.md",
      "IRIX_FILES.md",
      "docs/coverage.md",
      "docs/open-questions.md"
    ],
    "dumps": [],
    "skip": [
      "docs/inventory/*"
    ]
  },
  "prepare": [],
  "exclude": [],
  "windows": [],
  "bases": [],
  "accessors": [],
  "tokens": {
    "value_width": 3,
    "name_prefixes": [],
    "sources": []
  },
  "ioctls": {
    "send_functions": [],
    "ranges": [],
    "min_decimal": 1000,
    "dispatchers": [],
    "classes": [],
    "docs": [
      "docs/*.md"
    ]
  },
  "ucode": [],
  "spec_registers": [],
  "binaries": [
    {
      "group": "host-tools",
      "role": "sysco-host-tool",
      "paths": [
        "*/usr/sbin/flashsc",
        "*/usr/sbin/sysco/flashsc",
        "*/usr/sbin/l1cmd",
        "*/usr/sbin/flashpbay",
        "patches/*/usr/sbin/flashsc",
        "patches/*/usr/sbin/flashpbay"
      ]
    }
  ],
  "scope": [],
  "root_files": [
    "root/**/usr/cpu/firmware/sysco/*",
    "root/**/usr/sbin/*",
    "root/**/usr/sbin/sysco/*",
    "root/**/usr/cpu/firmware/*.bin",
    "root/**/usr/etc/*",
    "root/**/usr/cpu/sysgen/*/*.o",
    "root/**/sbin/scmsg",
    "root/**/usr/include/sys/EVEREST/sysctlr.h",
    "root/**/usr/share/catman/a_man/*/*.z",
    "root/patches/*/README.patch.*"
  ]
}
