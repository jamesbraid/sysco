<genxml unit="mcf5206e" prefix="SIM" title="on-chip registers of the ColdFire MCF5206e as the L1 firmware uses them">
  <doc>On-chip registers of the ColdFire MCF5206e that the L1 firmware uses. Offsets are from the
module base register and are given as constants; the registers are not modelled as a register
block. Only registers the L1 firmware touches are listed. Widths marked inferred follow the chip
manual's layout because the firmware access size was not separately read. The reset values are
not stated by any image, so they are unknown. Established means the firmware writes or tests the
register as stated; inferred means the layout is the public manual's and was not re-read in an
image.
</doc>
  <enum name="csmr0_bam">
    <value name="size_1mb" value="15" grade="established"/>
    <value name="size_2mb" value="31" grade="established"/>
  </enum>
  <enum name="csmr2_bam">
    <value name="size_128kb" value="1" grade="established"/>
    <value name="size_512kb" value="7" grade="established"/>
  </enum>
  <enum name="mfdr_mbc">
    <value name="divide_28" value="0" grade="inferred"/>
    <value name="divide_68" value="7" grade="inferred"/>
    <value name="divide_480" value="19" grade="inferred"/>
    <value name="divide_20" value="32" grade="inferred"/>
    <value name="divide_2048" value="63" grade="inferred"/>
  </enum>
  <struct name="CSMR0" size="4" grade="established">
    <doc>The firmware sizes the CS0 flash by writing the mask for 2 MB, then rewrites it
for 1 MB when the two halves of the window read back the same.</doc>
    <field name="bam" start="16" size="16" type="csmr0_bam" grade="established"/>
    <test value="0xf0000" kind="vector">
      <expect field="bam" value="15"/>
    </test>
    <test value="0x1f0000" kind="vector">
      <expect field="bam" value="31"/>
    </test>
  </struct>
  <struct name="CSMR2" size="4" grade="established">
    <doc>Chip-select 1 (battery-backed RAM and clock, 8-bit) and chip-select 2 (external RAM,
16-bit) values the board set-up writes. The RAM mask is cut from 512 KB to 128 KB when
the firmware's alias probe fails. The port-size decode of each control value is the
manual's and was not re-read in an image.</doc>
    <field name="bam" start="16" size="16" type="csmr2_bam" grade="established"/>
    <test value="0x10000" kind="vector">
      <expect field="bam" value="1"/>
    </test>
    <test value="0x70000" kind="vector">
      <expect field="bam" value="7"/>
    </test>
  </struct>
  <struct name="MADR" size="1" grade="inferred">
    <doc>M-Bus address register: the module's own seven-bit slave address, in bits 7 to 1. Bit 0 is
reserved. Reset value 0x00. Not the calling byte a master sends. Layout from the manual; the
firmware's own use is not re-read here.</doc>
    <field name="adr" start="1" size="7" type="uint" grade="inferred"/>
    <test value="0x58" kind="vector">
      <expect field="adr" value="44"/>
    </test>
  </struct>
  <struct name="MBCR" size="1" grade="inferred">
    <doc>M-Bus control register, reset value 0x00. MEN holds the module in reset while clear.
RSTA is write-one and always reads zero. Bits 1 and 0 are reserved. Other control bits have no
effect while MEN is clear.</doc>
    <field name="men" start="7" size="1" type="uint" grade="inferred"/>
    <field name="mien" start="6" size="1" type="uint" grade="inferred"/>
    <field name="msta" start="5" size="1" type="uint" grade="inferred"/>
    <field name="mtx" start="4" size="1" type="uint" grade="inferred"/>
    <field name="txak" start="3" size="1" type="uint" grade="inferred"/>
    <field name="rsta" start="2" size="1" type="uint" grade="inferred"/>
    <test value="0xf0" kind="vector">
      <expect field="men" value="1"/>
      <expect field="mien" value="1"/>
      <expect field="msta" value="1"/>
      <expect field="mtx" value="1"/>
      <expect field="txak" value="0"/>
      <expect field="rsta" value="0"/>
    </test>
  </struct>
  <struct name="MBDR" size="1" grade="inferred">
    <doc>M-Bus data register, reset value 0x00. A write starts the next transmit byte, most
significant bit first. A read in receive mode returns the received byte and starts receipt of the
next one.</doc>
    <field name="data" start="0" size="8" type="uint" grade="inferred"/>
  </struct>
  <struct name="MBSR" size="4" grade="established">
    <doc>M-Bus module. The offsets are the manual's, as the firmware adds them to the module base.
Reset value 0x81 (MCF and RXAK set). Software writes clear only MAL and MIF, by writing zero;
the other bits report hardware state.</doc>
    <field name="mcf" start="7" size="1" type="uint" grade="inferred"/>
    <field name="maas" start="6" size="1" type="uint" grade="inferred"/>
    <field name="bus_busy" start="5" size="1" type="uint" grade="established"/>
    <field name="mal" start="4" size="1" type="uint" grade="inferred"/>
    <field name="srw" start="2" size="1" type="uint" grade="inferred"/>
    <field name="mif" start="1" size="1" type="uint" grade="inferred"/>
    <field name="rxak" start="0" size="1" type="uint" grade="inferred"/>
    <test value="0x81" kind="vector">
      <expect field="mcf" value="1"/>
      <expect field="rxak" value="1"/>
    </test>
  </struct>
  <struct name="MFDR" size="1" grade="inferred">
    <doc>M-Bus frequency divider register, reset value 0x00. MBC5 to MBC0 select a divider
from the manual's table 13-2. The table value is a divider, not a bit rate. The errata says the
SCL frequency is the CPU frequency divided by the selected divider, and that the selection must
keep the M-Bus below 100 kHz. The rate in hertz is unknown until the controller clock is known.
Bits 7 and 6 are reserved; their readback is unknown.</doc>
    <field name="mbc" start="0" size="6" type="mfdr_mbc" grade="inferred"/>
    <test value="0x13" kind="vector">
      <expect field="mbc" value="19"/>
    </test>
  </struct>
  <struct name="PADAT" size="4" grade="established">
    <doc>Parallel port: direction and data, used as the scan-chain interface.</doc>
    <field name="tdi" start="7" size="1" type="uint" grade="established"/>
    <field name="tck" start="6" size="1" type="uint" grade="established"/>
    <field name="tms" start="5" size="1" type="uint" grade="established"/>
    <field name="trst" start="4" size="1" type="uint" grade="established"/>
    <field name="psi" start="3" size="1" type="uint" grade="established"/>
    <field name="tdo" start="0" size="1" type="uint" grade="established"/>
  </struct>
  <struct name="PAR" size="4" grade="established">
    <doc>Pin assignment: bit 7 is pulsed by the timer set-up, bits 5:4 are cleared by the scan set-up.</doc>
    <field name="timer_pulse" start="7" size="1" type="uint" grade="established"/>
    <field name="scan_sel" start="4" size="2" type="uint" grade="established"/>
  </struct>
  <struct name="RSR" size="4" grade="established">
    <doc>Reset status: one bit is tested at start-up to record the reset cause.</doc>
    <field name="cause5" start="5" size="1" type="uint" grade="established"/>
  </struct>
  <struct name="SYPCR" size="4" grade="established">
    <doc>Software watchdog control: write-once, armed once by the firmware.</doc>
    <field name="swe" start="7" size="1" type="uint" grade="established"/>
    <test value="0xfe" kind="vector">
      <expect field="swe" value="1"/>
    </test>
  </struct>
