  </struct>
  <struct name="PIMM_VCC" size="4" grade="established">
    <doc>Processor-module supply-good expanders: one per module, at the wire address of the first
control expander but on its own bus segment (segment 4 for module 0, segment 5 for module 1).
Reset hold sets both bits of the field; release clears both. The mask is not applied to
the written byte as an input mask.</doc>
    <field name="ok" start="6" size="2" type="uint" grade="established"/>
  </struct>
  <struct name="ROUTER" size="4" grade="established">
