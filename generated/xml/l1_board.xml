<genxml unit="l1_board" prefix="L1B" title="board-level bit layouts and constants of the ColdFire L1 firmware">
  <doc>Board-level bit layouts and constants of the ColdFire L1 firmware: bit positions of the I/O
expander bytes the L1 drives, the flash command stream, the quad UART, the battery-backed clock
window and the hardware monitor start-up values. Window offsets are relative to the base of the
device's chip select. Expander addresses come in the 8-bit wire form and the 7-bit form. Each
field carries the grade of the reading; polarity grades are given separately where the firmware
only shows that a bit is written.
</doc>
  <struct name="CACR" size="4" grade="inferred">
    <doc>Control-register codes of the MOVEC extension word and the values the firmware writes
at start-up. The register names are the manual's. Instruction cache control is written
twice: invalidate, then enable.</doc>
    <field name="cenb" start="31" size="1" type="uint" grade="inferred"/>
    <field name="cinv" start="24" size="1" type="uint" grade="inferred"/>
  </struct>
  <struct name="CLOCK" size="4" grade="established">
    <doc>Battery-backed clock: control byte at the top of the window; BCD time bytes follow it.</doc>
    <field name="write_enable" start="7" size="1" type="uint" grade="established"/>
    <field name="read_latch" start="6" size="1" type="uint" grade="established"/>
    <field name="century_tens" start="4" size="2" type="uint" grade="established"/>
    <field name="century_hundreds" start="0" size="4" type="uint" grade="established"/>
  </struct>
  <struct name="CNTL1" size="4" grade="established">
    <doc>Processor-module control expanders, wire addresses 0x42 and 0x44 (7-bit 0x21 and 0x22).</doc>
    <field name="soft_reset" start="7" size="1" type="uint" grade="established"/>
    <field name="nmi" start="6" size="1" type="uint" grade="established"/>
    <field name="reset_b" start="1" size="1" type="uint" grade="established"/>
    <field name="reset_a" start="0" size="1" type="uint" grade="established"/>
  </struct>
  <struct name="CNTL2" size="4" grade="unknown">
    <field name="strap" start="3" size="5" type="uint" grade="unknown"/>
